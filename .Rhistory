#| echo: true
flight1 <- flights |> filter(month == 1)
carrier_vec <- flights |> distinct(carrier) |> pull(carrier)
carrier_dist_vec_mean <- numeric(length(carrier_vec))
carrier_dist_vec_sd <- numeric(length(carrier_vec))
for (i in seq_along(carrier_vec)) {
carrier_data <- flights |> filter(carrier == carrier_vec[i])
carrier_dist_vec_mean[i] <- carrier_data |> summarize(mean_dist = mean(distance)) |> pull(mean_dist)
carrier_dist_vec_sd[i] <- carrier_data |> summarize(sd_dist = sd(distance)) |> pull(sd_dist)
}
dist_tbl <- tibble(
carrier = carrier_vec,
mean_distance = carrier_dist_vec_mean,
sd_distance = carrier_dist_vec_sd
)
dist_tbl |> arrange(mean_distance)
dist_tbl
dist_tbls <- flights |>
filter(month == 1) |>                     # Filter for January flights
group_by(carrier) |>                       # Group by carrier
summarize(
mean_distance = mean(distance, na.rm = F), # Compute mean distance
sd_distance = sd(distance, na.rm = F)     # Compute standard deviation
) |>
arrange(mean_distance)  # Sort by mean distance
print(dist_tbls)
mean()
